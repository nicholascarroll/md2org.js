#!/usr/bin/env node
/*
 * md2org CLI — a Unix filter. Reads Markdown, writes Org mode.
 *
 *   cat notes.md | md2org > notes.org
 *   md2org notes.md > notes.org
 *   md2org < notes.md
 *
 * Calls the identical core used by the web page and the iOS Shortcut.
 */
"use strict";

const fs = require("fs");
const path = require("path");
const md2org = require(path.join(__dirname, "..", "src", "md2org.js"));

const args = process.argv.slice(2);

if (args.includes("-h") || args.includes("--help")) {
  process.stdout.write(
    "md2org — convert Markdown to Org mode\n\n" +
    "Usage:\n" +
    "  md2org [file]        convert file (or stdin) to stdout\n" +
    "  cat f.md | md2org    read from a pipe\n\n" +
    "Options:\n" +
    "  -h, --help           show this help\n"
  );
  process.exit(0);
}

function convert(input) {
  process.stdout.write(md2org(input));
}

const fileArg = args.find((a) => !a.startsWith("-"));

if (fileArg) {
  let input;
  try {
    input = fs.readFileSync(fileArg, "utf8");
  } catch (e) {
    process.stderr.write("md2org: cannot read " + fileArg + ": " + e.message + "\n");
    process.exit(1);
  }
  convert(input);
} else {
  // read stdin
  const chunks = [];
  process.stdin.on("data", (c) => chunks.push(c));
  process.stdin.on("end", () => convert(Buffer.concat(chunks).toString("utf8")));
  process.stdin.resume();
}
