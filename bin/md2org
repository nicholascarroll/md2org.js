#!/usr/bin/env node
/*
 * md2org CLI: a Unix filter that reads Markdown and writes Org.
 *
 *   cat notes.md | md2org > notes.org
 *   md2org notes.md > notes.org
 *   md2org < notes.md
 *
 * Uses the same core as the web page and the iOS Shortcut.
 */
"use strict";

const fs = require("fs");
const path = require("path");
const md2org = require(path.join(__dirname, "..", "src", "md2org.js"));

const args = process.argv.slice(2);

const USAGE =
  "md2org — convert Markdown to Org mode\n\n" +
  "Usage:\n" +
  "  md2org [file]        convert file (or stdin) to stdout\n" +
  "  cat f.md | md2org    read from a pipe\n\n" +
  "Options:\n" +
  "  -e, --entities       decode HTML entities and numeric character references\n" +
  "                       to the characters they name (&mdash; and &#8212; to —)\n" +
  "  -h, --help           show this help\n" +
  "  -v, --version        show the version\n";

if (args.includes("-h") || args.includes("--help")) {
  process.stdout.write(USAGE);
  process.exit(0);
}

if (args.includes("-v") || args.includes("--version")) {
  process.stdout.write(require("../package.json").version + "\n");
  process.exit(0);
}

// Character-reference decoding, off by default (DESIGN.md, Character references
// and entities).
const entities = args.includes("-e") || args.includes("--entities");

// Reject unknown options rather than falling through to wait on stdin.
const badOpt = args.find((a) => a.startsWith("-") && a !== "-" &&
                                a !== "-e" && a !== "--entities");
if (badOpt) {
  process.stderr.write("md2org: unknown option " + badOpt + "\n\n" + USAGE);
  process.exit(2);
}

const fileArgs = args.filter((a) => !a.startsWith("-"));
if (fileArgs.length > 1) {
  process.stderr.write("md2org: expected at most one file, got " +
                       fileArgs.length + "\n\n" + USAGE);
  process.exit(2);
}

/*
 * Terminates the output with a newline, as a POSIX text file requires. The core
 * omits it because the browser and Shortcut place the result in a text box or on
 * the clipboard.
 */
function convert(input) {
  const out = entities ? md2org.withEntities(input) : md2org(input);
  process.stdout.write(out === "" ? out : out.replace(/\n?$/, "\n"));
}

const fileArg = fileArgs[0];

if (fileArg) {
  let input;
  try {
    input = fs.readFileSync(fileArg, "utf8");
  } catch (e) {
    process.stderr.write("md2org: cannot read " + fileArg + ": " + e.message + "\n");
    process.exit(1);
  }
  convert(input);
} else {
  // Reading stdin. A terminal means no pipe was given, so report it rather than
  // block.
  if (process.stdin.isTTY) {
    process.stderr.write("md2org: no input — give a file or pipe stdin\n\n" + USAGE);
    process.exit(2);
  }
  const chunks = [];
  process.stdin.on("data", (c) => chunks.push(c));
  process.stdin.on("end", () => convert(Buffer.concat(chunks).toString("utf8")));
  process.stdin.resume();
}
